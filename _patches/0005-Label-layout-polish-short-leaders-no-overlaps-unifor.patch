 /* ---- unobtrusive line callouts for realistic chapter plates ---- */
 .photo-wrap.annotated .photo-leaders{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}
-.photo-leader{fill:none;stroke:rgba(185,239,225,.72);stroke-width:1.35;vector-effect:non-scaling-stroke;transition:opacity .2s,stroke .2s}
+.photo-leader{fill:none;stroke:rgba(206,238,229,.7);stroke-width:1.1;vector-effect:non-scaling-stroke;transition:opacity .2s,stroke .2s}
 .photo-point{fill:#c6f7e9;stroke:#0b2926;stroke-width:1.5;vector-effect:non-scaling-stroke}
-.photo-wrap.annotated .photo-callout{position:absolute;z-index:3;transform:translateY(-50%);width:24%;max-width:185px;min-width:0;min-height:22px;padding:3px 5px;background:rgba(7,26,25,.73);border:0;border-radius:3px;color:#e7f9f4;font:650 10.5px/1.2 var(--sans);text-shadow:0 1px 2px #061616;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left}
+.photo-wrap.annotated .photo-callout{position:absolute;z-index:3;transform:translateY(-50%);width:23%;max-width:196px;min-width:0;min-height:20px;padding:2px 6px;background:rgba(6,24,23,.82);border:1px solid rgba(150,210,196,.14);border-radius:2px;color:#e7f9f4;font:600 10px/1.25 var(--sans);letter-spacing:.005em;text-shadow:0 1px 2px #061616;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:left;transition:background .16s,border-color .16s,color .16s}
+.photo-wrap.annotated.dense .photo-callout{font-size:9.5px;width:21%;max-width:184px;min-height:18px;padding:2px 5px}
+.photo-wrap.annotated.vdense .photo-callout{font-size:9px;width:19%;max-width:166px;min-height:17px;padding:1px 4px;letter-spacing:0}
+.photo-wrap.annotated.dense .photo-leader,.photo-wrap.annotated.vdense .photo-leader{stroke-width:1}
 .photo-wrap.annotated .photo-callout.l{left:1.5%;text-align:right}
 .photo-wrap.annotated .photo-callout.r{right:1.5%}
-.photo-wrap.annotated .photo-callout:hover,.photo-wrap.annotated .photo-callout.sel{color:#fff;background:rgba(11,86,77,.96)}
+.photo-wrap.annotated .photo-callout:hover,.photo-wrap.annotated .photo-callout.sel{color:#fff;background:rgba(11,86,77,.96);border-color:rgba(150,210,196,.5)}
 .photo-wrap.annotated .photo-hot{position:absolute;z-index:2;transform:translate(-50%,-50%);width:28px;height:28px;padding:0;border:0;background:transparent;border-radius:50%;cursor:pointer}
 .photo-wrap.annotated .photo-hot:focus-visible,.photo-wrap.annotated .photo-callout:focus-visible{outline:2px solid #f1c45a;outline-offset:1px}
