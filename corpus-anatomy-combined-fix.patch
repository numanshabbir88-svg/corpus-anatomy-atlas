+          "Plane",
+          "Description",
+          "Divides body into"
+        ],
+        "rows": [
+          [
+            "Sagittal plane",
+            "A vertical plane running from front to back",
+            "Left and right sections"
+          ],
+          [
+            "Midsagittal (median) plane",
+            "A sagittal plane exactly down the middle",
+            "Equal left and right halves"
+          ],
+          [
+            "Coronal (frontal) plane",
+            "A vertical plane running from side to side",
+            "Front (anterior) and back (posterior) sections"
+          ],
+          [
+            "Transverse (horizontal/axial) plane",
+            "A horizontal plane running parallel to the ground",
+            "Top (superior) and bottom (inferior) sections"
+          ]
+        ]
+      }
+    },
+    {
+      "id": "3-directional-terms-opposite-pairs",
