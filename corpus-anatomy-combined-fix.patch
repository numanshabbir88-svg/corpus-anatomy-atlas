+  "heroCaption": "Digital educational illustration for Human Kidney: Structure, Nephron & the Urinary System. This plate is a learning aid, not a clinical photograph.",
+  "takeaways": [
+    "Renal capsule: Tough fibrous layer covering the kidney.",
+    "Each kidney contains about 1 million nephrons . A nephron is the microscopic structure that performs filtration:",
+    "Kidneys (2): Produce urine."
+  ],
+  "sections": [
+    {
+      "id": "1-external-kidney-anatomy",
+      "heading": "1. External Kidney Anatomy",
+      "bullets": [
+        "Renal capsule: Tough fibrous layer covering the kidney.",
+        "Renal cortex: Outer region; contains glomeruli and convoluted tubules.",
+        "Renal medulla: Inner region with renal pyramids.",
+        "Renal pelvis: Funnel-shaped structure that collects urine before it enters the ureter.",
+        "Hilum: Entry/exit point for renal artery, renal vein, ureter, and nerves."
+      ]
+    },
+    {
+      "id": "2-the-nephron-functional-unit",
+      "heading": "2. The Nephron: Functional Unit",
+      "paragraphs": [
+        "Each kidney contains about 1 million nephrons . A nephron is the microscopic structure that performs filtration:",
+        "Filtration path: Blood → Glomerulus → Bowman's capsule → PCT → Loop of Henle → DCT → Collecting duct → Renal pelvis → Ureter"
+      ],
+      "bullets": [
+        "Renal corpuscle: Glomerulus (capillary ball) + Bowman's capsule.",
+        "Proximal convoluted tubule (PCT): Reabsorbs most water, glucose, and ions.",
+        "Loop of Henle: Concentrates urine; creates medullary osmotic gradient.",
+        "Distal convoluted tubule (DCT): Fine-tunes ion balance under hormonal control.",
+        "Collecting duct: Collects urine from multiple nephrons; carries it to the renal pelvis."
+      ]
+    },
+    {
+      "id": "3-urinary-pathway",
+      "heading": "3. Urinary Pathway",
+      "bullets": [
+        "Kidneys (2): Produce urine.",
+        "Ureters (2): Tubes carrying urine from kidneys to bladder.",
+        "Urinary bladder: Stores urine.",
+        "Urethra: Expels urine from the body."
+      ]
+    },
+    {
+      "id": "4-key-kidney-functions",
+      "heading": "4. Key Kidney Functions",
+      "bullets": [
+        "Filter ~180 liters of blood daily.",
+        "Regulate blood pressure via the renin-angiotensin system.",
+        "Maintain electrolyte balance (sodium, potassium, calcium).",
+        "Regulate blood pH.",
+        "Produce erythropoietin (stimulates red blood cell production).",
+        "Activate vitamin D for calcium absorption."
+      ]
+    }
+  ],
+  "questions": [
+    {
+      "question": "Q1. How many nephrons are in each kidney?",
+      "answer": "About 1 million nephrons per kidney."
+    },
+    {
+      "question": "Q2. Where does blood filtration occur in the kidney?",
+      "answer": "In the renal corpuscle — the glomerulus and Bowman's capsule."
+    },
+    {
+      "question": "Q3. What is the order of the urinary pathway?",
+      "answer": "Kidneys → ureters → urinary bladder → urethra."
+    },
+    {
+      "question": "Q4. What does the loop of Henle do?",
+      "answer": "It concentrates urine and creates the medullary osmotic gradient for water reabsorption."
+    },
+    {
+      "question": "Q5. What hormone do kidneys produce for red blood cells?",
+      "answer": "Erythropoietin stimulates red blood cell production in the bone marrow."
+    }
+  ],
+  "references": [
